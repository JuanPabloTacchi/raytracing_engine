#pragma once




float quick_hash(uint2* state) {
    state->x = state->x * 1664525u + 1013904223u;
    return (float)(state->x & 0xFFFFFF) / 16777216.0f;
}



float3 get_random_unit_vector(uint3* state) {
    float3 v;
    v.x = random_normal(state);
    v.y = random_normal(state);
    v.z = random_normal(state);   
    
    return normalize(v);
}


float3 get_random_hemisphere(uint2* state, float3 normal) {
    
    float3 v;
    v.x = quick_hash(state) * 2.0f - 1.0f;
    v.y = quick_hash(state) * 2.0f - 1.0f;
    v.z = quick_hash(state) * 2.0f - 1.0f;
    v = normalize(v);
    if (dot(v, normal) < 0.0f) {
        v = -v;
    }
    return v;
}