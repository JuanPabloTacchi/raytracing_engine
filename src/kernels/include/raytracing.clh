#pragma once

#include "ray.clh"
#include "triangles.clh"
#include "HittableObj.clh"
#include "object.clh"
#include "bsdf.clh"
#include "random.clh"



int max_bounce = 5;

//TODO:
//This is probably the least efficient thing to implement, i should probably try a bhv tree structure but works for now
bool getfirtsHit(Object* o, Triangle* triangle, float3* point, Ray r, int object_count, __global Object* objects, __global int* triangles, __global float4* points){
    float infinity_value = 1e30f;
    float t = infinity_value;
    //recursion for checking which object is first hitted
    for(int i = 0; i < object_count ; i++ ){
        Object o_i = objects[i];
        int n_triangles = o_i.n_triangles;
        for(int j = 0;  j < n_triangles; j++){
            Triangle new_triangle;
            int triangles_base_index = o_i.i_0 + j*3;

            int i0 = triangles[triangles_base_index];
            int i1 = triangles[triangles_base_index + 1];
            int i2 = triangles[triangles_base_index + 2];
            new_triangle.A = points[i0].xyz;
            new_triangle.B = points[i1].xyz;
            new_triangle.C = points[i2].xyz;
            float3 normal = triangle_get_normal(new_triangle);
            
            float t_i = plane_triangle_intersect(r,new_triangle,normal);
            
            if (t_i > 0.0001 && t_i < t){
                //check if point is inside triangle if not its discarded
                float3 point_in_triangle_plane = ray_col_point(r,t_i);
                bool is_inside_variable = is_inside(point_in_triangle_plane,new_triangle,normal);
                if(is_inside_variable){
                    *o = objects[i];
                    o->i_0 = objects[i].i_0;
                    o->i_f = objects[i].i_f;
                    o->n_triangles = objects[i].n_triangles;
                    o->hitObj.Material = objects[i].hitObj.Material;
                    o->hitObj.rgb = objects[i].hitObj.rgb;
                    t = t_i;
                    *triangle = new_triangle;
                    *point = point_in_triangle_plane; 
                }

            }
        }
    }
    if (t == infinity_value){
        return false;
    }
    
    return true;

}


//power: energy of light in all directions
//irradiance: energy of light per area entering the area
//radiance: energy of light per area per all directions

//L_o: radiance at observation point (ray origin)
//L_i: radiance from incident point

//IDEA
            //float3 radiance_o = Diffuse_BSDF(collision_point,wi,wo)*L_i; (remember the cosine(wo) is inside the diffuse bsdf)
            //colored radiance or stratified per color spectrum (thats not true cause im using rgb no real spectrum but its just for now)
            //float3 colored_radiance_o = radiance_o*color; 
float3 raytrace(Ray r, __global Object* objects,
    int objects_count,
    __global float4* points,
    int points_count,
    __global int* triangle_index,
    int triangles_count,
    uint2 seed){

    

    Object collision_obj;
    collision_obj.i_0 = 0;
    collision_obj.i_f = 1;
    collision_obj.n_triangles = 1;
    HittableObj hoTest;
    hoTest.Material = DIFUSSE;
    hoTest.rgb = (0,0,1);
    collision_obj.hitObj = hoTest;


    Triangle collision_triangle;
    float3 p1 = (float3)(0,0,0);
    float3 p2 = (float3)(1,0,0);
    float3 p3 = (float3)(0,1,0);
    collision_triangle.A = p1;
    collision_triangle.B = p2;
    collision_triangle.C = p3;
    float3 collision_point = (float3)(0,0,0);
   
    float3 rgb = (float3)(0,0,0); //ilumination
    float3 L_i = (float3)(0,0,0);
    float3 L_i_recursive_multiplication = (float3)(1,1,1);
    float3 object_color_rgb = (float3)(0,0,0);
    
    //as there cant be recursion in gpu we have to use a while loop
    while(r.bounces < max_bounce){
        
        bool res = getfirtsHit(&collision_obj, &collision_triangle, &collision_point, r, objects_count, objects, triangle_index, points);
        
        if (res == false){
            if (r.bounces == 0){
                rgb = (float3)(0,0,0);
                return rgb;
            }
            L_i = (float3)(0,0,0); //BUG: en caso de que el primer rayo desaparesca de la existencia, este no tiene valor de rgb y explota el compilador
            break;
            
        }
       
        float3 normal = triangle_get_normal(collision_triangle);
        int material = collision_obj.hitObj.Material;
        object_color_rgb = collision_obj.hitObj.rgb;
        //only diffuse materials at the moment
        if (material == DIFUSSE){
            
            Ray new_ray;
            new_ray.d = get_random_hemisphere(&seed, normal);
            
            float3 normal_epsilon_error = normal*0.001f; //for floating point error we take a bit off the collision point
            new_ray.o = collision_point + normal_epsilon_error;
            new_ray.bounces = r.bounces;
            float cos_wo = dot(normal, new_ray.d); //angle beetween 2 vector, remember cos(o) = a*b/||a||||b|| (normal and new_ray.d are normalized)
            float cos_wi = dot(normal,-r.d); 
            float wo = acos(cos_wo); //TODO: check the domain with clamp
            float wi = acos(cos_wi);
            
            L_i_recursive_multiplication = Diffuse_BSDF(collision_point,wi,wo)*L_i_recursive_multiplication;
            L_i_recursive_multiplication = L_i_recursive_multiplication*object_color_rgb;
            r = new_ray;
        }
      
        if (material == EMISSIVE){
            L_i = (float3)(10,10,10)*object_color_rgb; 
            break;
        }
        r.bounces = r.bounces + 1;
    }
    
    float3 radiance_o = L_i_recursive_multiplication * L_i;
    rgb = radiance_o*object_color_rgb;
    return rgb;
}

